---
import SiteLayout from '../layouts/SiteLayout.astro';
import Artwork from '../components/Artwork.astro';
import Arrow from '../components/Arrow.astro';
import { lattice } from '../data/games';
---
<SiteLayout title="Games Library — Small worlds. Deep rabbit holes." description="An independent collection of browser games by Søborg-Madsen. Discover Lattice, a real-time strategy game about energy, expansion, and survival." page="home">
  <section class="hero" aria-labelledby="hero-title">
    <Artwork class="hero-art" eager={true} source={lattice.artwork} />
    <div class="hero-shade"></div>
    <div class="hero-content">
      <div class="hero-eyebrow"><span class="status-dot"></span><span>Featured game</span><span class="eyebrow-divider"></span><span>{lattice.genre}</span></div>
      <h1 id="hero-title">{lattice.title}</h1>
      <p class="hero-tagline">{lattice.tagline}</p>
      <p class="hero-description">A world of connections.<br />Every one worth defending.</p>
      <div class="hero-actions">
        <a class="button" href={lattice.url}>Play Lattice <Arrow /></a>
        <a class="text-link" href="#discover">Discover the game <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-meta"><span>Play in your browser</span><span>{lattice.players}</span></div>
    </div>
    <div class="hero-index" aria-hidden="true"><span>01</span><span class="vertical-rule"></span><span>THE FIRST CONNECTION</span></div>
    <div class="hero-bottom">
      <a href="/library/">Explore the library <Arrow /></a>
      <span>Terrain <i>/</i> Energy <i>/</i> Defence</span>
      <span class="art-caption">Lattice · Cover illustration</span>
    </div>
  </section>

  <section class="discover section-shell" id="discover" aria-labelledby="discover-title">
    <div class="section-intro">
      <div><p class="eyebrow">Inside Lattice</p><h2 id="discover-title">Small decisions.<br /><em>Chain reactions.</em></h2></div>
      <p class="intro-copy">A single connection becomes a network. A network becomes a foothold. Then the world pushes back.</p>
    </div>
    <div class="mechanics">
      <article><span class="step-number">01 / CONNECT</span><h3>Keep the energy moving.</h3><p>Link your transmitters. Route photons across the map. Build a network that can handle the pressure.</p></article>
      <article><span class="step-number">02 / EXPAND</span><h3>Make room to grow.</h3><p>Reach new minerals and claim more ground. Every expansion gives you more to build—and more to protect.</p></article>
      <article><span class="step-number">03 / DEFEND</span><h3>Hold it all together.</h3><p>Put your power to work. Build laser defences and repair your network as enemy waves close in.</p></article>
    </div>
    <div class="discover-bottom"><p>Your first connection is waiting.</p><a class="text-link" href={lattice.url}>Enter Lattice <Arrow /></a></div>
  </section>
</SiteLayout>
